# Copy to .env and fill in. Never commit .env.

# --- docker compose ---
POSTGRES_USER=seven
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seven
SEVEN_WEB_PORT=3000

# --- backend (prefix SEVEN_) ---
SEVEN_ENVIRONMENT=development
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SEVEN_SECRET_KEY=change-me
# Needed from Phase 4 (Claude orchestrator). Stays server-side; never sent to the browser.
SEVEN_ANTHROPIC_API_KEY=

# Native (non-docker) development only:
# SEVEN_DATABASE_URL=postgresql+asyncpg://seven:seven@localhost:5432/seven
# SEVEN_REDIS_URL=redis://localhost:6379/0
