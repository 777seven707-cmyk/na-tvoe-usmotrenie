# Copy to .env and fill in. Never commit .env.

# --- docker compose ---
POSTGRES_USER=nikita
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nikita
NIKITA_WEB_PORT=3000

# --- backend (prefix NIKITA_) ---
NIKITA_ENVIRONMENT=development
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NIKITA_SECRET_KEY=change-me
# Needed from Phase 4 (Claude orchestrator). Stays server-side; never sent to the browser.
NIKITA_ANTHROPIC_API_KEY=

# Native (non-docker) development only:
# NIKITA_DATABASE_URL=postgresql+asyncpg://nikita:nikita@localhost:5432/nikita
# NIKITA_REDIS_URL=redis://localhost:6379/0
